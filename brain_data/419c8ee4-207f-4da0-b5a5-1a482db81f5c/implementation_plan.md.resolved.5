**1. Modify the existing [Home](file:///d:/dev/Ayurved/Ayurved_bkp12032026/AyurvedaPortal/Controllers/LoginController.cs#30-69) (GET) method:** 
We will catch the URL payload inside the existing GET request handler. Upon successful validation, it uses the shared session logic to log in.

```csharp
public ActionResult Home(string UserName = null, string Token = null, string timestamp = null)
{
    // 1. Is it a Seamless Login Payload?
    if (!string.IsNullOrEmpty(UserName) && !string.IsNullOrEmpty(Token) && !string.IsNullOrEmpty(timestamp))
    {
        // 2. Validate Token and Timestamp
        if (IsValidPayload(Token, timestamp)) 
        {
            // 3. Mock Modal
            LoginRepository Modal = new LoginRepository();
            Modal.UserName = UserName;
            Modal.UserType = "S";  // Set to S

            // 4. Authenticate
            Modal = Modal.isValidUser(Modal);

            if (!string.IsNullOrEmpty(Modal.Roles) && Modal.UserStatus != "Login Failed")
            {
                // 5. Generate Sessions & Auth Cookies using the new method
                CreateUserSession(Modal);
                
                return Redirect(Modal.UserTypeUrl);
            }
            else 
            {
                return RedirectToAction("Home", "Login", new { Error = PortalEncryption.EncryptPassword("Direct login failed.") });
            }
        }
    }

    // --- EXISTING LOGIC STARTS HERE ---
    if (Session["ADUserinfo"] != null)
    // ...
```

